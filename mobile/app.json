{
  "expo": {
    "name": "青跑团",
    "slug": "qingrun",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "qingrun",
    "userInterfaceStyle": "light",
    "description": "面向 10–20 岁青少年的公益长跑成长平台",
    "ios": {
      "icon": "./assets/expo.icon",
      "supportsTablet": false,
      "bundleIdentifier": "com.qingrun.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E3EFE9",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.qingrun.app"
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "青跑团只在开跑时使用定位来计算距离，不保存轨迹。"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "青跑团只读取你主动选择的跑步截图，不会浏览整个相册。"
        }
      ],
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#0E5A4A",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 76
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false,
      "reactCompiler": true
    }
  }
}
