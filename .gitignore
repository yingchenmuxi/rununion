# ===== 后端 =====
# 第三方依赖，克隆后用 npm install 重新安装
backend/node_modules/

# 本地数据库与备份（可用 node seed_articles.js 重新生成）
backend/data/

# 用户运行时上传的文件；只保留知识库自带的示例配图
backend/uploads/*
!backend/uploads/art_*.jpg
!backend/uploads/article_*.jpg

# 日志与临时文件
*.log
server.log
server_err.log

# 环境变量文件（可能含密钥，不要上传）
.env
.env.*

# ===== 客户端（Flutter 自身规则见 client/.gitignore）=====
client/android/build/

# ===== 系统文件 =====
Thumbs.db
.DS_Store
