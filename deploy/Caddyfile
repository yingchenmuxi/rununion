{
	admin off
}

{$SITE_ADDRESS} {
	encode zstd gzip
	root * /srv/mobile

	@api path /api/*
	handle @api {
		reverse_proxy api:8090
	}

	handle {
		try_files {path} /index.html
		file_server
	}

	@assets path /_expo/* /assets/*
	header @assets Cache-Control "public, max-age=31536000, immutable"

	@icons path /icons/*
	header @icons Cache-Control "public, max-age=86400"

	@nocache path / /index.html /sw.js /manifest.webmanifest
	header @nocache Cache-Control "no-cache, no-store, must-revalidate"

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "geolocation=(self)"
	}
}

:8081 {
	root * /srv/admin

	@admin_api path /api/*
	handle @admin_api {
		reverse_proxy api:8090
	}

	handle {
		try_files {path} /index.html
		file_server
	}

	header {
		X-Robots-Tag "noindex, nofollow"
		X-Content-Type-Options nosniff
	}
}